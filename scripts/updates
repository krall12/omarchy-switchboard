#!/bin/bash
# Prints the number of pending Omarchy updates (0 when up to date).
set -uo pipefail
# omarchy-update-available prints "Omarchy is up to date" and exits 1 when
# nothing is pending, so the exit code — not the line count — decides.
if output=$(omarchy-update-available 2>/dev/null); then
  count=$(printf '%s\n' "$output" | grep -c .)
else
  count=0
fi
printf '%s\n' "${count:-0}"
exit 0
